<div class="container-fluid">

    <!-- Page Heading -->
    <h1 class="h3 mb-2 text-gray-800">Products</h1>
    <p class="mb-4">DataTables is a third party plugin that is used to generate the demo table below.
        For more information about DataTables, please visit the <a target="_blank"
            href="https://datatables.net">official DataTables documentation</a>.</p>

    <!-- DataTales Example -->
               <form method="POST" action="/admin/product-update" enctype="multipart/form-data">
                <div class="modal-body">

                    <div data-mdb-input-init class="form-outline mb-4">
                        <input name="Id" type="number" id="IdProductUpdateForm" class="form-control form-control-lg" readonly value="<%= product.id %>" />
                        <label class="form-label" for="IdProductUpdateForm">ID</label>
                    </div>
                    <!-- Product Name -->
                    <div data-mdb-input-init class="form-outline mb-4">
                        <input name="name" type="text" id="createProduct14" class="form-control form-control-lg" value="<%= product.name %>"/>
                        <label class="form-label" for="createProduct14">Name</label>
                    </div>

                    <!-- Price -->
                    <div data-mdb-input-init class="form-outline mb-4">
                        <input type="text" name="price" id="createProduct15" class="form-control form-control-lg" value="<%= product.price %>"/>
                        <label class="form-label" for="createProduct15">Price</label>
                    </div>

                    <!-- description -->
                    <div data-mdb-input-init class="form-outline mb-4">
                        <input type="text" name="description" id="createProduct16" class="form-control form-control-lg" value="<%= product.description %>"/>
                        <label class="form-label" for="createProduct16">Description</label>
                    </div>


                    <!-- Image Upload -->
                    <div data-mdb-input-init class="form-outline mb-4">
                        <input type="file" name="image" id="createProductImage" class="form-control form-control-lg" accept="image/*" />
                        <label class="form-label" for="createProductImage">Upload Image</label>
                    </div>
                </div>

                <div class="modal-footer">
                    <button type="submit" data-mdb-button-init data-mdb-ripple-init class="btn btn-primary btn-lg btn-block">
                        Save Product
                    </button>
                </div>
            </form>

</div>