<div class="modal fade" id="CreateModal" tabindex="-1" role="dialog" aria-labelledby="exampleModalLabel"
    aria-hidden="true">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title-create-product" id="createProductModal">Create Product</h5>
                <button class="close" type="button" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">×</span>
                </button>
            </div>
            <form method="POST" action="/admin/create-article">
                <div class="modal-body">

                    <!-- title -->
                    <div data-mdb-input-init class="form-outline mb-4">
                        <input name="title" type="text" id="createProduct14" class="form-control form-control-lg" />
                        <label class="form-label" for="createProduct14">Name</label>
                    </div>


                    <!-- content -->
                    <div data-mdb-input-init class="form-outline mb-4">
                        <textarea name="content" class="form-control form-control-lg" ></textarea>
                        <label class="form-label" for="createProduct16">content</label>
                    </div>

                </div>

                <div class="modal-footer">
                    <button type="submit" data-mdb-button-init data-mdb-ripple-init class="btn btn-primary btn-lg btn-block">
                        Create article
                    </button>
                    <button type="button" class="btn btn-secondary btn-lg btn-block" data-bs-dismiss="modal" aria-label="Close">
                        Cancel
                    </button>
                </div>
            </form>

        </div>
    </div>
</div>

