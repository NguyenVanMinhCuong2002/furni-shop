<div class="modal fade" id="CreateModal" tabindex="-1" role="dialog" aria-labelledby="exampleModalLabel"
    aria-hidden="true">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title-create" id="createUserModal">Create User</h5>
                <button class="close" type="button" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">×</span>
                </button>
            </div>
            <form method="POST" action="create-user">
                <div class="modal-body">
                    
                        <div data-mdb-input-init class="form-outline mb-4">
                            <input name="email" type="email" id="form1Example13" class="form-control form-control-lg" />
                            <label class="form-label" for="form1Example13">Email address</label>
                        </div>

                        <!-- Full Name input -->
                        <div data-mdb-input-init class="form-outline mb-4">
                            <input name="name" type="text" id="form1Example14" class="form-control form-control-lg" />
                            <label class="form-label" for="form1Example14">Full name</label>
                        </div>

                        <!-- Username input -->
                        <div data-mdb-input-init class="form-outline mb-4">
                            <input type="text" name="username" id="form1Example16" class="form-control form-control-lg" />
                            <label class="form-label" for="form1Example16">Username</label>
                        </div>

                        <!-- Phone -->
                        <div data-mdb-input-init class="form-outline mb-4">
                            <input type="text" name="phone" id="form1Example15" class="form-control form-control-lg" />
                            <label class="form-label" for="form1Example15">Phone</label>
                        </div>

                        <!-- Password input -->
                        <div data-mdb-input-init class="form-outline mb-4">
                            <input type="password" name="password" id="form1Example23" class="form-control form-control-lg" />
                            <label class="form-label" for="form1Example23">Password</label>
                        </div>
                        
                        <!--Role Input-->
                        <div data-mdb-input-init class="form-outline mb-4">
                            <label for="roleInput" class="form-label">Role</label>
                            <input class="form-control" list="roleList" id="roleInput" name="role" placeholder="Chọn role">
                            <datalist id="roleList">
                                <option value="user">
                                <option value="admin">
                            </datalist>
                        </div>
                        
                    </div>

                    <div class="modal-footer">
                        <button type="submit" data-mdb-button-init data-mdb-ripple-init class="btn btn-primary btn-lg btn-block">create User</button>
                        <button type="button" class="btn btn-secondary btn-lg btn-block" data-bs-dismiss="modal" aria-label="Close">cancel</button>
                    </div>
                </div>
            </form>
    </div>
</div>

