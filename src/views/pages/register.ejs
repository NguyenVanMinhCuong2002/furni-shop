<section class="vh-100">
  <div class="container py-5 h-100">
    <div class="row d-flex align-items-center justify-content-center h-100">
      <div class="col-md-8 col-lg-7 col-xl-6">
        <img src="https://mdbcdn.b-cdn.net/img/Photos/new-templates/bootstrap-login-form/draw2.svg"
          class="img-fluid" alt="Phone image">
      </div>
      <div class="col-md-7 col-lg-5 col-xl-5 offset-xl-1">
        <a href="login" >Login</a>
        <form method="post" action="/register">
          <h2>Register</h2>
          <!-- Email input -->
          <div data-mdb-input-init class="form-outline mb-4">
            <input name="email" type="email" id="form1Example13" class="form-control form-control-lg" required/>
            <label class="form-label" for="form1Example13">Email address</label>
          </div>

           <!-- Full Name input -->
         <div data-mdb-input-init class="form-outline mb-4">
            <input name="name" type="text" id="form1Example14" class="form-control form-control-lg" required/>
            <label class="form-label" for="form1Example14">Full name</label>
          </div>

          <!-- Username input -->
         <div data-mdb-input-init class="form-outline mb-4">
            <input type="text" name="username" id="form1Example16" class="form-control form-control-lg" required/>
            <label class="form-label" for="form1Example16">Username</label>
          </div>

          <!-- Phone -->
         <div data-mdb-input-init class="form-outline mb-4">
            <input type="text" name="phone" id="form1Example15" class="form-control form-control-lg" required/>
            <label class="form-label" for="form1Example15">Phone</label>
          </div>

          <!-- Password input -->
          <div data-mdb-input-init class="form-outline mb-4">
            <input type="password" name="password" id="form1Example23" class="form-control form-control-lg" required/>
            <label class="form-label" for="form1Example23">Password</label>
          </div>

          <% if (typeof error !== "undefined") { %>
              <div style="color: red;"><%= error %></div>
          <% } %>
          <!-- Submit button -->
          <button type="submit" data-mdb-button-init data-mdb-ripple-init class="btn btn-primary btn-lg btn-block">Register</button>


        </form>
      </div>
    </div>
  </div>
</section>