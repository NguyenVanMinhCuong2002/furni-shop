<div class="container-fluid">

    <!-- Page Heading -->
    <h1 class="h3 mb-2 text-gray-800">Products</h1>
    <p class="mb-4">DataTables is a third party plugin that is used to generate the demo table below.
        For more information about DataTables, please visit the <a target="_blank"
            href="https://datatables.net">official DataTables documentation</a>.</p>

    <!-- DataTales Example -->
    <form method="POST" action="/admin/user-update">
    <div class="modal-body">

            <div data-mdb-input-init class="form-outline mb-4">
                <input name="Id" type="email" id="IdUpdateForm" class="form-control form-control-lg" readonly value="<%= user.id %>" />
                <label class="form-label" for="IdUpdateForm">ID</label>
            </div>

        
            <div data-mdb-input-init class="form-outline mb-4">
                <input name="email" type="email" id="emailUpdateForm" class="form-control form-control-lg" value="<%= user.email %>" />
                <label class="form-label" for="emailUpdateForm">Email address</label>
            </div>

            <!-- Full Name input -->
            <div data-mdb-input-init class="form-outline mb-4">
                <input name="name" type="text" id="nameUpdateForm" class="form-control form-control-lg" value="<%= user.name %>"/>
                <label class="form-label" for="nameUpdateForm">Full name</label>
            </div>

            <!-- Username input -->
            <div data-mdb-input-init class="form-outline mb-4">
                <input type="text" name="username" id="userUpdateForm" class="form-control form-control-lg" value="<%= user.username %>"/>
                <label class="form-label" for="userUpdateForm">Username</label>
            </div>

            <!-- Phone -->
            <div data-mdb-input-init class="form-outline mb-4">
                <input type="text" name="phone" id="phoneUpdateForm" class="form-control form-control-lg" value="<%= user.phone %>"/>
                <label class="form-label" for="phoneUpdateForm">Phone</label>
            </div>

            <!-- Password input -->
            <div data-mdb-input-init class="form-outline mb-4">
                <input type="password" name="password" id="passwordUpdateForm" class="form-control form-control-lg" value="" required/>
                <label class="form-label" for="passwordUpdateForm">Password</label>
            </div>
            
            <!--Role Input-->
            <div data-mdb-input-init class="form-outline mb-4">
                <label for="roleInput" class="form-label">Role</label>
                <input class="form-control" list="roleList" id="roleUpdateForm" name="role" placeholder="Chọn role" value="<%= user.role %>">
                <datalist id="roleList">
                    <option value="user">
                    <option value="admin">
                </datalist>
            </div>
            
        </div>
            <button type="submit" data-mdb-button-init data-mdb-ripple-init class="btn btn-primary btn-lg btn-block">Save User</button>
        
    </div>
</form>
</div>