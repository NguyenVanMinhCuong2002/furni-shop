<div class="modal fade" id="CreateModal" tabindex="-1" role="dialog" aria-labelledby="exampleModalLabel"
    aria-hidden="true">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title-create-product" id="createProductModal">Create Product</h5>
                <button class="close" type="button" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">×</span>
                </button>
            </div>
            <form method="POST" action="/admin/create-product" enctype="multipart/form-data">
                <div class="modal-body">

                    <!-- Product Name -->
                    <div data-mdb-input-init class="form-outline mb-4">
                        <input name="name" type="text" id="createProduct14" class="form-control form-control-lg" />
                        <label class="form-label" for="createProduct14">Name</label>
                    </div>

                    <!-- Price -->
                    <div data-mdb-input-init class="form-outline mb-4">
                        <input type="text" name="price" id="createProduct15" class="form-control form-control-lg" />
                        <label class="form-label" for="createProduct15">Price</label>
                    </div>

                    <!-- description -->
                    <div data-mdb-input-init class="form-outline mb-4">
                        <input type="text" name="description" id="createProduct16" class="form-control form-control-lg" />
                        <label class="form-label" for="createProduct16">Description</label>
                    </div>


                    <!-- Image Upload -->
                    <div data-mdb-input-init class="form-outline mb-4">
                        <input type="file" name="image" id="createProductImage" class="form-control form-control-lg" accept="image/*" />
                        <label class="form-label" for="createProductImage">Upload Image</label>
                    </div>
                </div>

                <div class="modal-footer">
                    <button type="submit" data-mdb-button-init data-mdb-ripple-init class="btn btn-primary btn-lg btn-block">
                        Create Product
                    </button>
                    <button type="button" class="btn btn-secondary btn-lg btn-block" data-bs-dismiss="modal" aria-label="Close">
                        Cancel
                    </button>
                </div>
            </form>

        </div>
    </div>
</div>

